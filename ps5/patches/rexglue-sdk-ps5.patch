+extern "C" int sceSystemServiceLoadExec(const char* path, char* const argv[]);
+static void Ps5Notify(const char* text) {
+  struct {
+    char unused[45];
+    char message[3075];
+  } request;
+  std::memset(&request, 0, sizeof(request));
+  std::strncpy(request.message, text, sizeof(request.message) - 1);
