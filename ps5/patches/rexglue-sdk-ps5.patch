diff --git a/include/rex/audio/ps5/ps5_audio_driver.h b/include/rex/audio/ps5/ps5_audio_driver.h
new file mode 100644
index 0000000..1d95637
--- /dev/null
+++ b/include/rex/audio/ps5/ps5_audio_driver.h
@@ -0,0 +1,46 @@
+#pragma once
+/**
+ * [ps5 port] Audio out through sceAudioOut: the Xbox 360's 48 kHz frames of
+ * 256 samples x 6 channels, folded to stereo 16-bit (the port format the
+ * UnleashedRecomp PS5 port verified), pushed by a thread of its own.
+ */
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <queue>
+#include <stack>
+#include <thread>
+
+#include <rex/audio/audio_driver.h>
+#include <rex/thread.h>
+
+namespace rex::audio::ps5 {
+
+class Ps5AudioDriver : public AudioDriver {
+ public:
+  Ps5AudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore);
+  ~Ps5AudioDriver() override;
+
+  bool Initialize();
+  void SubmitFrame(uint32_t frame_ptr) override;
+  void Shutdown();
+
+ private:
+  void OutputThread();
+
+  static constexpr uint32_t kFrequency = 48000;
+  static constexpr uint32_t kChannels = 6;
+  static constexpr uint32_t kChannelSamples = 256;
+  static constexpr uint32_t kFrameSamples = kChannels * kChannelSamples;
+
+  rex::thread::Semaphore* semaphore_ = nullptr;
+  int32_t port_ = -1;
+  std::thread thread_;
+  std::atomic<bool> running_{false};
+
+  std::queue<float*> frames_queued_;
+  std::stack<float*> frames_unused_;
+  std::mutex frames_mutex_;
+};
+
+}  // namespace rex::audio::ps5
diff --git a/include/rex/input/ps5/ps5_input_driver.h b/include/rex/input/ps5/ps5_input_driver.h
new file mode 100644
index 0000000..d735d1d
--- /dev/null
+++ b/include/rex/input/ps5/ps5_input_driver.h
@@ -0,0 +1,47 @@
+#pragma once
+/**
+ * [ps5 port] DualSense controllers through scePad: one Xbox 360 pad per
+ * logged-in PS5 user that has a controller.
+ */
+#include <array>
+#include <cstdint>
+#include <mutex>
+
+#include <rex/input/input_driver.h>
+
+namespace rex::input::ps5 {
+
+class Ps5InputDriver final : public InputDriver {
+ public:
+  explicit Ps5InputDriver(rex::ui::Window* window, size_t window_z_order);
+  ~Ps5InputDriver() override;
+
+  X_STATUS Setup() override;
+  X_RESULT GetCapabilities(uint32_t user_index, uint32_t flags,
+                           X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT GetState(uint32_t user_index, X_INPUT_STATE* out_state) override;
+  X_RESULT GetStateUi(uint32_t user_index, X_INPUT_STATE* out_state) override;
+  X_RESULT SetState(uint32_t user_index, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetKeystroke(uint32_t user_index, uint32_t flags,
+                        X_INPUT_KEYSTROKE* out_keystroke) override;
+
+ private:
+  static constexpr size_t kMaxPads = 4;
+  struct Pad {
+    int32_t user_id = -1;
+    int32_t handle = -1;
+    uint32_t packet_number = 0;
+    X_INPUT_GAMEPAD last_gamepad{};
+    uint32_t keystroke_buttons = 0;  // the buttons the keystroke events last reported
+  };
+  // A pad by the game's user index (0..3: the PS5 users in login order).
+  Pad* PadFor(uint32_t user_index);
+  void RefreshPads();
+  X_RESULT ReadState(uint32_t user_index, bool active, X_INPUT_STATE* out_state);
+
+  std::mutex mutex_;
+  std::array<Pad, kMaxPads> pads_{};
+  uint64_t last_refresh_ms_ = 0;
+};
+
+}  // namespace rex::input::ps5
