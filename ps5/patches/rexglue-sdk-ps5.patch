+                                 rex::ui::Ps5DisplaySurface& surface, VkSurfaceKHR& surface_out) {
+  sceSystemServiceHideSplashScreen();
+  if (!ifn.vkGetPhysicalDeviceDisplayPropertiesKHR || !ifn.vkCreateDisplayPlaneSurfaceKHR) {
+    return VK_ERROR_EXTENSION_NOT_PRESENT;
+  }
+  uint32_t display_count = 0;
+  VkResult res = ifn.vkGetPhysicalDeviceDisplayPropertiesKHR(physical_device, &display_count, nullptr);
+  if (res != VK_SUCCESS || !display_count) {
+    REXLOG_ERROR("PS5 display: no displays ({})", int(res));
+    return VK_ERROR_INITIALIZATION_FAILED;
+  }
+  std::vector<VkDisplayPropertiesKHR> displays(display_count);
+  res = ifn.vkGetPhysicalDeviceDisplayPropertiesKHR(physical_device, &display_count, displays.data());
+  if (res != VK_SUCCESS) return res;
+  uint32_t plane_count = 0;
+  res = ifn.vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physical_device, &plane_count, nullptr);
+  if (res != VK_SUCCESS || !plane_count) {
+    REXLOG_ERROR("PS5 display: no display planes ({})", int(res));
+    return VK_ERROR_INITIALIZATION_FAILED;
+  }
+  std::vector<VkDisplayPlanePropertiesKHR> planes(plane_count);
+  res = ifn.vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physical_device, &plane_count, planes.data());
+  if (res != VK_SUCCESS) return res;
+
+  VkDisplayKHR display = VK_NULL_HANDLE;
+  VkDisplayModeKHR mode = VK_NULL_HANDLE;
+  VkExtent2D extent = {3840, 2160};
+  for (uint32_t i = 0; i < display_count && mode == VK_NULL_HANDLE; ++i) {
+    uint32_t mode_count = 0;
+    if (ifn.vkGetDisplayModePropertiesKHR(physical_device, displays[i].display, &mode_count,
+                                          nullptr) != VK_SUCCESS ||
+        !mode_count) {
+      continue;
+    }
+    std::vector<VkDisplayModePropertiesKHR> modes(mode_count);
+    if (ifn.vkGetDisplayModePropertiesKHR(physical_device, displays[i].display, &mode_count,
+                                          modes.data()) != VK_SUCCESS) {
+      continue;
+    }
+    display = displays[i].display;
+    mode = modes[0].displayMode;
+    extent = modes[0].parameters.visibleRegion;
+    for (const VkDisplayModePropertiesKHR& m : modes) {
+      if (m.parameters.visibleRegion.width == 3840 && m.parameters.visibleRegion.height == 2160) {
+        mode = m.displayMode;
+        extent = m.parameters.visibleRegion;
+        break;
+      }
+    }
+  }
+  if (mode == VK_NULL_HANDLE) {
+    REXLOG_ERROR("PS5 display: no usable display mode");
+    return VK_ERROR_INITIALIZATION_FAILED;
+  }
+  uint32_t plane = 0;
+  for (uint32_t i = 0; i < plane_count; ++i) {
+    if (planes[i].currentDisplay == VK_NULL_HANDLE || planes[i].currentDisplay == display) {
+      plane = i;
+      break;
+    }
+  }
+  VkDisplaySurfaceCreateInfoKHR info = {};
+  info.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+  info.displayMode = mode;
+  info.planeIndex = plane;
+  info.planeStackIndex = planes[plane].currentStackIndex;
+  info.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+  info.globalAlpha = 1.0f;
+  info.alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+  info.imageExtent = extent;
+  res = ifn.vkCreateDisplayPlaneSurfaceKHR(instance, &info, nullptr, &surface_out);
+  if (res == VK_SUCCESS) {
+    surface.SetSize(extent.width, extent.height);
+    REXLOG_INFO("PS5 display: {}x{} on plane {}", extent.width, extent.height, plane);
+  }
+  return res;
+}
